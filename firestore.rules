rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 컨설턴트 본인 정보만 접근 가능
    match /consultants/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. 학생 정보: 본인이 담당하는 학생만 접근 가능
    match /students/{studentId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.consultantId == request.auth.uid ||
        request.resource.data.consultantId == request.auth.uid
      );
    }
    
    // 3. 활동 메모: 해당 학생을 담당하는 컨설턴트만 접근 가능
    match /memos/{memoId} {
      allow read, write: if request.auth != null; 
    }

    // 4. 서브 관리자 (매니저): 이메일 기반 접근
    match /managers/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow write: if request.auth != null && (
        (request.auth.token.email.lower() == email.lower()) ||
        (request.resource.data.parentId == request.auth.uid)
      );
    }

    // 기본 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

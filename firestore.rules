rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 컨설턴트 본인 정보만 접근 가능
    match /consultants/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. 학생 정보: 본인이 담당하는 학생만 접근 가능
    match /students/{studentId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.consultantId == request.auth.uid ||
        request.resource.data.consultantId == request.auth.uid
      );
    }
    
    // 3. 활동 메모: 해당 학생을 담당하는 컨설턴트만 접근 가능
    match /memos/{memoId} {
      allow read, write: if request.auth != null; // 서버 사이드에서 주로 처리하지만 기본 보안 강화
    }

    // 기본 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
